# Copia este archivo a .env y completa con valores locales.
# .env está en .gitignore — no commitear valores reales.

# Entorno: development | staging | production
APP_ENV=development

# Supabase (anon key en cliente; service role SOLO en Edge Functions)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Firebase — FCM + Hosting (project id del entorno)
# FIREBASE_PROJECT_ID=

# Pasarela de pagos — PAUSADA en v1 (no configurar aún)
# WOMPI_EVENTS_SECRET=
# PAYU_MERCHANT_ID=
