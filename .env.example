# Plantilla — copiar a `.env` y completar:
#   cp .env.example .env
#
# `.env` está en .gitignore y se carga solo en la app (flutter_dotenv).
# En CI, el workflow genera `.env` antes del build.

APP_ENV=development

SUPABASE_URL=
SUPABASE_ANON_KEY=

# Opcional: URL completa del deep link de recuperación (ej. https://app.com/reset-password)
AUTH_REDIRECT_URL=

FIREBASE_PROJECT_ID=
